FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends iproute2 iputils-ping && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir cryptography==44.0.1
WORKDIR /app
COPY protocol.py network_utils.py fault_policy.py view_change.py view_runtime.py node_v2.py driver_v2.py collector_v2.py grouping.py ./
COPY netem_apply.sh netem_clear.sh ./
CMD ["python", "node_v2.py"]
